# BreatheWise backend configuration.
# Copy this file to .env and fill in your own values. Never commit .env.

FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-string

# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Google Gemini (optional). Leave blank to run the clearly-labelled demo
# assistant, which uses live environmental data plus a local rule engine.
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 only if you deliberately want the labelled demo dataset when
# Open-Meteo is unreachable. Live data is always preferred.
DEMO_MODE=0

# Operational tuning (seconds / requests per minute).
HTTP_TIMEOUT_SECONDS=12
AIR_CACHE_TTL_SECONDS=600
GEO_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=90
ASSISTANT_RATE_LIMIT_PER_MINUTE=15
GENERATION_RATE_LIMIT_PER_MINUTE=30

PORT=5000
HOST=127.0.0.1
